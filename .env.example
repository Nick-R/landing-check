# Скопируйте в .env.local и заполните. Настоящие значения в репозиторий не попадают.

# Postgres (Neon). На Vercel переменную создаёт подключение базы.
DATABASE_URL=postgres://user:password@host/db

# Языковая модель: любой OpenAI-совместимый API
LLM_BASE_URL=https://api.zveno.ai/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5.5
# Цена за миллион токенов в рублях - по ней считается дневной потолок
LLM_PRICE_IN_RUB_PER_M=390
LLM_PRICE_OUT_RUB_PER_M=1940

# Защита открытого сервиса
DAILY_BUDGET_RUB=300
RATE_PER_IP_HOUR=6
RATE_PER_IP_DAY=20
IP_SALT=любая-случайная-строка

# Только для тестов: ответ-заглушка вместо модели
# LLM_MOCK=1
